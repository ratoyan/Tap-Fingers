<resources>

    <!-- API 31+ draws the splash itself from the platform attributes, so set them
         directly rather than relying on the ?attr indirection in Theme.SplashScreen. -->
    <style name="SplashTheme" parent="Theme.SplashScreen">
        <item name="postSplashScreenTheme">@style/AppTheme</item>
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
    </style>

</resources>
